{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "avatar_emoji": {
      "type": "string",
      "default": "\ud83e\udd89"
    },
    "total_xp": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "streak": {
      "type": "number",
      "default": 0
    },
    "last_study_date": {
      "type": "string",
      "format": "date"
    },
    "total_study_minutes": {
      "type": "number",
      "default": 0
    },
    "quizzes_taken": {
      "type": "number",
      "default": 0
    },
    "avg_score": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "display_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}