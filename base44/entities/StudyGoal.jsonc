{
  "name": "StudyGoal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "flashcards",
        "quiz",
        "notes",
        "custom"
      ]
    },
    "target_count": {
      "type": "number",
      "default": 1
    },
    "completed": {
      "type": "number",
      "default": 0
    },
    "goal_date": {
      "type": "string",
      "format": "date"
    },
    "done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "goal_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}