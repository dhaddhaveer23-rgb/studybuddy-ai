{
  "name": "Exam",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "exam_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "default": "violet"
    }
  },
  "required": [
    "title",
    "exam_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}